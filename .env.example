# Copier ce fichier en .env (cp .env.example .env) et changer les mots de passe.
# Le fichier .env n'est jamais versionné (.gitignore).

COMPOSE_PROJECT_NAME=obslab

# --- Application ---
APP_VERSION=1.0.0
CHAOS_ENABLED=true
LOG_LEVEL=INFO

# --- PostgreSQL ---
POSTGRES_VERSION=17
DB_NAME=commandes
DB_USER=commandes
DB_PASSWORD=change-moi
PROMETHEUS_VERSION=v3.13.5
